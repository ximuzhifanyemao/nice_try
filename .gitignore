# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
dev-dist
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Android (Capacitor)
android/local.properties
android/.idea/
android/captures/
android/.gradle/
*.iml

# App icon source (generated by capacitor-assets, regenerated on demand)
assets/
# PWA icons（仅忽略仓库根目录的参考副本；public/icons 供 manifest.webmanifest 使用，需提交）
icons/
!public/icons/

# OTA 上传配置（含 service_role key，不能提交）
.env.ota

# APK 构建产物（放 apk/ 目录，不进 git，避免被嵌入 App 资产导致体积膨胀）
apk/
*.apk

# 本地 JDK（构建用，不进 git）
jdk-*/

# AI 解析批量生成缓存（scripts/gen-ai-analysis.cjs 断点续跑用，体积大不进 git）
scripts/_ai-results.json

# Rust 工具链（Tauri 桌面端，装在项目下避免越权限；体积大不进 git）
/.rustup/
/.cargo/

# AI 解析批量生成的中间文本（与 _ai-results.json 同批，体积大不进 git）
scripts/_ky*.txt

# WorkBuddy 会话数据
.workbuddy/
