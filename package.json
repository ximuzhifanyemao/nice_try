{
  "name": "kaoyan-tracker",
  "private": true,
  "version": "1.13.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:deploy": "vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "cap:sync": "npm run build:deploy && npx cap sync",
    "cap:android": "npm run build:deploy && npx cap sync android && npx cap open android",
    "cap:run:android": "npm run build:deploy && npx cap sync android && npx cap run android",
    "tauri": "tauri",
    "ota:upload": "node scripts/upload-ota.mjs",
    "ota:version": "node -e \"const p=require('./package.json');console.log('v'+p.version)\""
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor-mlkit/barcode-scanning": "^8.1.0",
    "@capacitor/android": "^8.5.0",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.0",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "@capgo/capacitor-updater": "^8.51.8",
    "@supabase/supabase-js": "^2.112.0",
    "@tauri-apps/api": "^2.11.1",
    "@types/qrcode": "^1.5.6",
    "date-fns": "^4.4.0",
    "jsqr": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
