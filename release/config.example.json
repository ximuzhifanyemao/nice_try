{
  "configVersion": 1,
  "cloudbase": {
    "cliPath": "D:\\cloudbase-cli\\cloudbase.cmd",
    "envId": "your-env-id",
    "siteUrl": "https://your-env-id-1234567890.tcloudbaseapp.com",
    "staticDomain": "https://your-env-id-1234567890.tcloudbaseapp.com",
    "deployArgs": [
      "--verify"
    ],
    "region": "ap-shanghai"
  },
  "android": {
    "javaHome": "C:\\Program Files\\Java\\jdk-21",
    "sdkDir": "C:\\Users\\<you>\\AppData\\Local\\Android\\Sdk",
    "gradleTask": "assembleRelease",
    "otaHost": "cloudbase",
    "cloudbaseDir": "downloads",
    "supabaseBucket": "ota-bundles"
  },
  "desktop": {
    "cargoBin": "C:\\Users\\<you>\\.cargo\\bin",
    "bundles": "",
    "otaHost": "cloudbase",
    "cloudbaseDir": "downloads/desktop",
    "supabaseBucket": "desktop-bundles"
  },
  "git": {
    "exe": "C:\\Program Files\\Git\\cmd\\git.exe"
  },
  "github": {
    "enabled": true,
    "owner": "your-github-owner",
    "repo": "your-repo",
    "tokenEnv": "GITHUB_TOKEN"
  },
  "server": {
    "port": 4780,
    "openBrowser": true
  },
  "options": {
    "allowDirty": false,
    "stepTimeoutMinutes": 40,
    "keepHistory": 80
  }
}
