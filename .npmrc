# CloudBase 云端构建国内网络优化：
# sharp（@capacitor/assets 依赖）默认从 GitHub 下载 libvips 预编译包，国内常被断连，
# 通过 npmmirror 二进制镜像加速（与 package-lock.json 的 registry.npmmirror.com 保持一致）。
sharp_binary_host=https://registry.npmmirror.com/-/binary/sharp
sharp_libvips_binary_host=https://registry.npmmirror.com/-/binary/sharp-libvips
